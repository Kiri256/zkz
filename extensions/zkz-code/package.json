{
  "name": "zkz-code",
  "displayName": "zkz Code",
  "description": "yt_version macros, inactive #if folding, and clangd index.",
  "version": "0.0.57",
  "publisher": "zkz",
  "icon": "media/zkz-code.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:c",
    "onLanguage:cpp"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "zkz-code.refreshIfdefFolds",
        "title": "zkz Code: Refresh #if Folds"
      },
      {
        "command": "zkz-code.toggleIfdefFolds",
        "title": "zkz Code: Toggle #if Folds"
      },
      {
        "command": "zkz-code.refreshCompileCommands",
        "title": "zkz Code: Refresh compile_commands"
      },
      {
        "command": "zkz-code.restartClangd",
        "title": "zkz Code: Restart clangd"
      },
      {
        "command": "zkz-code.invalidateMacroImpactIndex",
        "title": "zkz Code: Clear clangd Index"
      },
      {
        "command": "zkz-code.restoreCmsisInclude",
        "title": "zkz Code: Restore CMSIS Include (Worktree Only)"
      }
    ]
  },
  "dependencies": {
    "fast-xml-parser": "5.11.2",
    "iconv-lite": "^0.6.3"
  },
  "scripts": {
    "test": "node test/run.js"
  }
}