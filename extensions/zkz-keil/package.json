{
  "name": "zkz-keil",
  "displayName": "zkz Keil",
  "description": "Keil UV4 build, J-Link flash, and Cortex-Debug prepare. True-source + zkz-native builds the keil-native tree.",
  "version": "0.0.37",
  "publisher": "zkz",
  "icon": "media/zkz-keil.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onTaskType:zkz-keil"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "zkz-keil.keilBuild",
        "title": "zkz: 编译",
        "icon": "$(tools)",
        "enablement": "zkzKeil.paired"
      },
      {
        "command": "zkz-keil.keilRebuild",
        "title": "zkz: 重新编译",
        "icon": "$(sync)",
        "enablement": "zkzKeil.paired"
      },
      {
        "command": "zkz-keil.keilFlash",
        "title": "zkz: 烧录",
        "icon": "$(zap)",
        "enablement": "zkzKeil.paired"
      },
      {
        "command": "zkz-keil.prepareCortexDebug",
        "title": "zkz: 准备调试",
        "icon": "$(debug-alt)",
        "enablement": "zkzKeil.paired"
      },
      {
        "command": "zkz-keil.configureLaunch",
        "title": "zkz: 配置调试",
        "icon": "$(debug-configure)",
        "enablement": "zkzKeil.paired"
      },
      {
        "command": "zkz-keil.jlinkGdbServerPath",
        "title": "zkz: J-Link GDB Server Path"
      },
      {
        "command": "zkz-keil.debugSpeed",
        "title": "zkz: Debug Speed"
      },
      {
        "command": "zkz-keil.gdbPath",
        "title": "zkz: GDB Path"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "zkz-keil.jlinkGdbServerPath",
          "when": "false"
        },
        {
          "command": "zkz-keil.gdbPath",
          "when": "false"
        },
        {
          "command": "zkz-keil.debugSpeed",
          "when": "false"
        }
      ]
    },
    "problemMatchers": [
      {
        "name": "zkz-keil",
        "owner": "zkz-keil",
        "source": "keil",
        "fileLocation": "autoDetect",
        "pattern": {
          "regexp": "^(.+)\\((\\d+)\\):\\s*(error|warning|Error|Warning)\\s*:\\s*(.+)$",
          "file": 1,
          "line": 2,
          "severity": 3,
          "message": 4
        }
      }
    ],
    "taskDefinitions": [
      {
        "type": "zkz-keil",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string",
            "description": "build, rebuild, flash, prepare, buildFlashPrepare"
          }
        }
      }
    ]
  },
  "scripts": {
    "test": "node test/run.js"
  },
  "dependencies": {
    "iconv-lite": "^0.6.3"
  }
}